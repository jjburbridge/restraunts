{"_id":"tour-restaurants","_type":"tour","label":"Managing restaurants","description":"Find, create and edit restaurants, link their locations, and publish your changes.","steps":[{"_type":"tourStep","_key":"r1","title":"Welcome to restaurants","description":[{"_type":"block","_key":"r1b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"r1s1","text":"This tour shows where restaurants live in the Studio, how to create one, and what each of the main fields is for.","marks":[]}]}],"delay":300},{"_type":"tourStep","_key":"r2","title":"The Restaurants folder","description":[{"_type":"block","_key":"r2b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"r2s1","text":"Restaurants and their locations are grouped together in the Restaurants folder in the sidebar.","marks":[]}]}],"target":"sidebar","side":"right","align":"start"},{"_type":"tourStep","_key":"r3","title":"All restaurants","description":[{"_type":"block","_key":"r3b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"r3s1","text":"This list shows every restaurant. Click one to open it, or use the search at the top of the list to find it by name.","marks":[]}]}],"target":"document-list","openPath":"/structure/restaurants;restaurant","side":"right","align":"start"},{"_type":"tourStep","_key":"r4","title":"Create a restaurant","description":[{"_type":"block","_key":"r4b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"r4s1","text":"Use this button to start a new restaurant. It opens a blank draft that only you can see until you publish it.","marks":[]}]}],"target":"pane-create","openPath":"/structure/restaurants;restaurant","side":"bottom","align":"end"},{"_type":"tourStep","_key":"r5","title":"Restaurant name","description":[{"_type":"block","_key":"r5b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"r5s1","text":"The name shown on the website. It's required, so a restaurant can't be published without one.","marks":[]}]}],"target":"field:restaurant_name","openDocument":{"_type":"reference","_ref":"0022b504-2549-4a05-9bd7-e8107007545f"},"side":"bottom","align":"start"},{"_type":"tourStep","_key":"r6","title":"Locations","description":[{"_type":"block","_key":"r6b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"r6s1","text":"Link each branch of the restaurant here. Locations are their own documents, so the same address is never typed twice. Use Clear all below the list to remove every linked location at once.","marks":[]}]}],"target":"field:locations","openDocument":{"_type":"reference","_ref":"0022b504-2549-4a05-9bd7-e8107007545f"},"side":"bottom","align":"start"},{"_type":"tourStep","_key":"r7","title":"Average rating","description":[{"_type":"block","_key":"r7b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"r7s1","text":"The restaurant's average review score. It's required and is used to sort restaurants on the website.","marks":[]}]}],"target":"field:avg_rating","openDocument":{"_type":"reference","_ref":"0022b504-2549-4a05-9bd7-e8107007545f"},"side":"bottom","align":"start"},{"_type":"tourStep","_key":"r8","title":"Cuisines","description":[{"_type":"block","_key":"r8b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"r8s1","text":"Pick one or more cuisines. Visitors use these to filter restaurants on the website.","marks":[]}]}],"target":"field:cuisines","openDocument":{"_type":"reference","_ref":"0022b504-2549-4a05-9bd7-e8107007545f"},"side":"bottom","align":"start"},{"_type":"tourStep","_key":"r9","title":"Features","description":[{"_type":"block","_key":"r9b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"r9s1","text":"Add features such as outdoor seating or Wi-Fi. To empty any field, open the ⋯ menu next to its title and choose Unset.","marks":[]}]}],"target":"field:features","openDocument":{"_type":"reference","_ref":"0022b504-2549-4a05-9bd7-e8107007545f"},"side":"top","align":"start"},{"_type":"tourStep","_key":"r10","title":"Publish your changes","description":[{"_type":"block","_key":"r10b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"r10s1","text":"Edits are saved as a draft automatically. Publish to make them live on the website.","marks":[]}]}],"target":"publish-button","openDocument":{"_type":"reference","_ref":"0022b504-2549-4a05-9bd7-e8107007545f"},"side":"top","align":"end"}]}
{"_id":"tour-locations","_type":"tour","label":"Managing locations","description":"Add restaurant locations, set their map position, and enter a valid UK address.","steps":[{"_type":"tourStep","_key":"l1","title":"Welcome to locations","description":[{"_type":"block","_key":"l1b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"l1s1","text":"A location is a single restaurant branch: where it is on the map and its postal address. Restaurants link to their locations.","marks":[]}]}],"delay":300},{"_type":"tourStep","_key":"l2","title":"All locations","description":[{"_type":"block","_key":"l2b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"l2s1","text":"Every location is listed here by its first address line and town.","marks":[]}]}],"target":"document-list","openPath":"/structure/restaurants;location","side":"right","align":"start"},{"_type":"tourStep","_key":"l3","title":"Create a location","description":[{"_type":"block","_key":"l3b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"l3s1","text":"Start a new location here. You can also create one straight from a restaurant's Locations field.","marks":[]}]}],"target":"pane-create","openPath":"/structure/restaurants;location","side":"bottom","align":"end"},{"_type":"tourStep","_key":"l4","title":"Latitude","description":[{"_type":"block","_key":"l4b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"l4s1","text":"Latitude and longitude place the pin on the website's map and power distance sorting. Both are required.","marks":[]}]}],"target":"field:latitude","openDocument":{"_type":"reference","_ref":"e740abb5-451e-4a80-ac91-fe2c6c3d4a3e"},"side":"bottom","align":"start"},{"_type":"tourStep","_key":"l5","title":"Longitude","description":[{"_type":"block","_key":"l5b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"l5s1","text":"Copy both values from a map service such as Google Maps. In the UK, longitude is usually a small negative number.","marks":[]}]}],"target":"field:longitude","openDocument":{"_type":"reference","_ref":"e740abb5-451e-4a80-ac91-fe2c6c3d4a3e"},"side":"bottom","align":"start"},{"_type":"tourStep","_key":"l6","title":"Address line 1","description":[{"_type":"block","_key":"l6b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"l6s1","text":"The building number and street. Together with the town, this is the title shown in location lists.","marks":[]}]}],"target":"field:address.line1","openDocument":{"_type":"reference","_ref":"e740abb5-451e-4a80-ac91-fe2c6c3d4a3e"},"side":"bottom","align":"start"},{"_type":"tourStep","_key":"l7","title":"Postcode","description":[{"_type":"block","_key":"l7b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"l7s1","text":"Must be a valid UK postcode, for example NE1 6EF. The Studio flags an invalid one before you can publish.","marks":[]}]}],"target":"field:address.postcode","openDocument":{"_type":"reference","_ref":"e740abb5-451e-4a80-ac91-fe2c6c3d4a3e"},"side":"top","align":"start"},{"_type":"tourStep","_key":"l8","title":"Publish the location","description":[{"_type":"block","_key":"l8b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"l8s1","text":"Publish to make the location live. Any restaurant linked to it picks up the change automatically.","marks":[]}]}],"target":"publish-button","openDocument":{"_type":"reference","_ref":"e740abb5-451e-4a80-ac91-fe2c6c3d4a3e"},"side":"top","align":"end"}]}
{"_id":"tour-cuisines","_type":"tour","label":"Managing cuisines","description":"Create and rename cuisines, tag restaurants with them, and see where each one is used.","steps":[{"_type":"tourStep","_key":"c1","title":"Welcome to cuisines","description":[{"_type":"block","_key":"c1b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"c1s1","text":"Cuisines are a shared list, such as French or Chinese, that restaurants are tagged with. Visitors use them to filter restaurants on the website.","marks":[]}]}],"delay":300},{"_type":"tourStep","_key":"c2","title":"All cuisines","description":[{"_type":"block","_key":"c2b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"c2s1","text":"Every cuisine is listed here. Check this list before adding a new one, so the same cuisine isn't created twice.","marks":[]}]}],"target":"document-list","openPath":"/structure/cuisine","side":"right","align":"start"},{"_type":"tourStep","_key":"c3","title":"Create a cuisine","description":[{"_type":"block","_key":"c3b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"c3s1","text":"Add a new cuisine here. You can also create one straight from a restaurant's Cuisines field.","marks":[]}]}],"target":"pane-create","openPath":"/structure/cuisine","side":"bottom","align":"end"},{"_type":"tourStep","_key":"c4","title":"Cuisine name","description":[{"_type":"block","_key":"c4b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"c4s1","text":"The only field on a cuisine, and it's required. Renaming a cuisine updates it on every restaurant that uses it.","marks":[]}]}],"target":"field:name","openDocument":{"_type":"reference","_ref":"87cc19ae-65e5-423c-bf61-9fc2ca2e6012"},"side":"bottom","align":"start"},{"_type":"tourStep","_key":"c5","title":"See where it's used","description":[{"_type":"block","_key":"c5b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"c5s1","text":"Open this menu and choose Incoming references to see every restaurant tagged with this cuisine. Check it before deleting a cuisine.","marks":[]}]}],"target":"show-more","openDocument":{"_type":"reference","_ref":"87cc19ae-65e5-423c-bf61-9fc2ca2e6012"},"side":"bottom","align":"end"},{"_type":"tourStep","_key":"c6","title":"Publish the cuisine","description":[{"_type":"block","_key":"c6b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"c6s1","text":"Publish to make a new or renamed cuisine live on the website.","marks":[]}]}],"target":"publish-button","openDocument":{"_type":"reference","_ref":"87cc19ae-65e5-423c-bf61-9fc2ca2e6012"},"side":"top","align":"end"},{"_type":"tourStep","_key":"c7","title":"Tag a restaurant","description":[{"_type":"block","_key":"c7b1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"c7s1","text":"Cuisines are added to a restaurant from its Cuisines field. Pick one or more from the shared list.","marks":[]}]}],"target":"field:cuisines","openDocument":{"_type":"reference","_ref":"0022b504-2549-4a05-9bd7-e8107007545f"},"side":"bottom","align":"start"}]}
